# The ВЛ10 under its own 3 kV DC, the same as vl10_compressor_ac.script: the
# compressor brings the main reservoir back up past its governor's cut-in.
#
#   openrts-train-check <RTS root> --dll mdd_vl10u-053 mdd_VL10u-053A mdd_VL10u-053B --start on
#       --brakes openrts --seconds 150 --script tests/data/vl10_compressor_dc.script
# The ВЛ10's 395 is switch 0 (VI 0, I 6, II 5).
0    voltage 3000 0
1    switch 0 0
6    switch 0 6
14    switch 0 0
19    switch 0 6
27    switch 0 0
32    switch 0 6
40    switch 0 0
45    switch 0 6
53    switch 0 0
58    switch 0 6
66    switch 0 0
71    switch 0 6
79   switch 0 5
139  expect mr > 8.5          # the compressor ran
