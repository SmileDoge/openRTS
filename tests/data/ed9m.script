# ED9M-0062 (mdd_ED9M-0062: head car G, motor M, trailer P, rear head GR).
# The reverser C_REV is a KEY switch (States ( 3 1 ), KEY): every cab starts
# with its key out (RTS 0x51B98C), Init puts the player's in at 3 (forward).
# The DLL's CanSwitch refuses it while a slave head car's key is in, so a
# rear cab started with the key in (as before) locked it.
#
#   openrts-train-check <RTS root> --dll mdd_ED9M-0062 mdd_ED9M-0062_G mdd_ED9M-0062_M mdd_ED9M-0062_P mdd_ED9M-0062_GR --script tests/data/ed9m.script
0.5  expect key1 == 3          # Init: the player's key in, forward
1    switch 1 2                # to neutral
1.5  expect key1 == 2
2    switch 1 1                # back
3    expect reverse == -1
4    switch 1 3                # forward again
5    expect reverse == 1
5    expect alive == 1
# Driving on an AC line (the ED9M works on 22..30 kV 50 Hz): the controller
# to M, then I; the motor cars pull. Before the cab switch arrays had the
# .sd's declared size, the MaDaDev brakes read an undeclared switch as -1
# ("a stop valve pulled") and vented the pipe: the train stood braked.
5    voltage 25000 50
6    switch 0 6
8    switch 0 7
# The train starts with the air its Init leaves (RTS: the cars' auxiliary
# reservoirs empty, enter_new_train), so the pipe dips on charging them and
# comes back: about 4.2 at 18 s.
18   expect speed > 1
18   expect pipe > 4
# The cab screens the DLLs fill (КЛУБ display 180, САВПЭ 499): the speed
# limit and the clock as labels (the world clock, RTS_VAR_TIME, runs from
# 12:00 with the simulation), the white aspect shown.
18   screen 180 24 043
18   screen 180 26 12.00.17
18   screen 180 9 shown
18   screen 499 0 12:00:17
# Doors (GM_DOOR_OPEN / CLOSE by GlobalID, docs/reverse/train-dll.md):
# the driver's left-door control on, the left doors (A_00) open; the
# passenger doors of group 2 (DOOR_D, DOOR_E of the head car) open in
# their AnimTime (5 s), the cab doors stay shut.
19   switch 7 1
20   switch 24 0
# GM_DOOR_OPEN sets the doors' State at once (RTS 0x424488), the cab's own
# passenger doors (DOOR_A .. E, GlobalID) too: the DLL reads those, and its
# door lamp L_14 (display 7) came back on 2.5 s later when they stayed shut.
20.5 door 0 2 open
24   expect disp7 == 0
27   door 0 2 open
27   door 0 3 open
27   door 0 0 closed
# Lamps (GM_LIGHT_ON by GlobalID): the salon light switch lights group 2
# in every car, the cab light the cab's lamps.
28   switch 30 1
28   switch 31 1
29   lamp 1 0 on
29   lamp 0 1 on
