+// openRTS's fork (Windows): a fence shared by an NT handle (a D3D11 fence
+// made with D3D11_FENCE_FLAG_SHARED), opened by the device: D3D12's
+// OpenSharedHandle, or on Vulkan a timeline semaphore importing it
+// (VK_KHR_external_semaphore_win32, the D3D12 fence handle type). Signalled
+// and waited for on the queue (wgpuQueueSignal/WaitSharedFence), so wgpu and
+// D3D11 keep in step on the GPU.
+#[cfg(windows)]
+pub enum SharedFence {
+    #[cfg(feature = "dx12")]
+    D3d12(windows::Win32::Graphics::Direct3D12::ID3D12Fence),
+    #[cfg(feature = "vulkan")]
+    Vulkan {
+        device: ash::Device,
+        semaphore: ash::vk::Semaphore,
+    },
+}
+
+#[cfg(windows)]
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceOpenSharedFence(
+    device: native::WGPUDevice,
+    shared_handle: *mut std::ffi::c_void,
+) -> *mut std::ffi::c_void {
+    let (device_id, context) = {
+        let device = device.as_ref().expect("invalid device");
+        (device.id, &device.context)
+    };
+    #[cfg(feature = "dx12")]
+    if let Some(hal_device) = context.device_as_hal::<hal::api::Dx12>(device_id) {
+        let mut fence: Option<windows::Win32::Graphics::Direct3D12::ID3D12Fence> = None;
+        if let Err(error) = hal_device
+            .raw_device()
+            .OpenSharedHandle(windows::Win32::Foundation::HANDLE(shared_handle), &mut fence)
+        {
+            log::error!("wgpuDeviceOpenSharedFence (D3D12): {error:?}");
+            return std::ptr::null_mut();
+        }
+        return match fence {
+            Some(fence) => Box::into_raw(Box::new(SharedFence::D3d12(fence))) as *mut std::ffi::c_void,
+            None => std::ptr::null_mut(),
+        };
+    }
+    #[cfg(feature = "vulkan")]
+    if let Some(hal_device) = context.device_as_hal::<hal::api::Vulkan>(device_id) {
+        use ash::vk;
+        if !hal_device.enabled_device_extensions().contains(&ash::khr::external_semaphore_win32::NAME) {
+            log::error!("wgpuDeviceOpenSharedFence (Vulkan): VK_KHR_external_semaphore_win32 not enabled");
+            return std::ptr::null_mut();
+        }
+        let raw = hal_device.raw_device().clone();
+        let instance = hal_device.shared_instance().raw_instance();
+        let mut timeline = vk::SemaphoreTypeCreateInfo::default()
+            .semaphore_type(vk::SemaphoreType::TIMELINE)
+            .initial_value(0);
+        let info = vk::SemaphoreCreateInfo::default().push_next(&mut timeline);
+        let semaphore = match raw.create_semaphore(&info, None) {
+            Ok(semaphore) => semaphore,
+            Err(error) => {
+                log::error!("wgpuDeviceOpenSharedFence (Vulkan): {error:?}");
+                return std::ptr::null_mut();
+            }
+        };
+        let import = ash::khr::external_semaphore_win32::Device::new(instance, &raw);
+        let import_info = vk::ImportSemaphoreWin32HandleInfoKHR::default()
+            .semaphore(semaphore)
+            .handle_type(vk::ExternalSemaphoreHandleTypeFlags::D3D12_FENCE)
+            .handle(shared_handle as isize);
+        if let Err(error) = import.import_semaphore_win32_handle(&import_info) {
+            log::error!("wgpuDeviceOpenSharedFence (Vulkan import): {error:?}");
+            raw.destroy_semaphore(semaphore, None);
+            return std::ptr::null_mut();
+        }
+        return Box::into_raw(Box::new(SharedFence::Vulkan { device: raw, semaphore })) as *mut std::ffi::c_void;
+    }
+    let _ = shared_handle;
+    log::error!("wgpuDeviceOpenSharedFence: neither D3D12 nor Vulkan");
+    std::ptr::null_mut()
+}
+
+#[cfg(windows)]
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceReleaseSharedFence(fence: *mut std::ffi::c_void) {
+    if fence.is_null() {
+        return;
+    }
+    let fence = Box::from_raw(fence as *mut SharedFence);
+    match *fence {
+        #[cfg(feature = "dx12")]
+        SharedFence::D3d12(_) => {}
+        #[cfg(feature = "vulkan")]
+        SharedFence::Vulkan { ref device, semaphore } => device.destroy_semaphore(semaphore, None),
+    }
+}
+
+#[cfg(windows)]
+unsafe fn shared_fence_on_queue(
+    queue: native::WGPUQueue,
+    fence: *mut std::ffi::c_void,
+    value: u64,
+    signal: bool,
+) -> bool {
+    let (queue_id, context) = {
+        let queue = queue.as_ref().expect("invalid queue");
+        (queue.queue.id, &queue.queue.context)
+    };
+    let Some(fence) = (fence as *const SharedFence).as_ref() else {
+        return false;
+    };
+    match fence {
+        #[cfg(feature = "dx12")]
+        SharedFence::D3d12(fence) => {
+            let Some(hal_queue) = context.queue_as_hal::<hal::api::Dx12>(queue_id) else {
+                return false;
+            };
+            let result = if signal {
+                hal_queue.as_raw().Signal(fence, value)
+            } else {
+                hal_queue.as_raw().Wait(fence, value)
+            };
+            if let Err(error) = result {
+                log::error!("wgpuQueue*SharedFence (D3D12): {error:?}");
+                return false;
+            }
+            true
+        }
+        #[cfg(feature = "vulkan")]
+        SharedFence::Vulkan { device, semaphore } => {
+            use ash::vk;
+            let Some(hal_queue) = context.queue_as_hal::<hal::api::Vulkan>(queue_id) else {
+                return false;
+            };
+            let semaphores = [*semaphore];
+            let values = [value];
+            let stages = [vk::PipelineStageFlags::ALL_COMMANDS];
+            let result = if signal {
+                let mut timeline = vk::TimelineSemaphoreSubmitInfo::default().signal_semaphore_values(&values);
+                let submit = vk::SubmitInfo::default().signal_semaphores(&semaphores).push_next(&mut timeline);
+                device.queue_submit(hal_queue.as_raw(), &[submit], vk::Fence::null())
+            } else {
+                let mut timeline = vk::TimelineSemaphoreSubmitInfo::default().wait_semaphore_values(&values);
+                let submit = vk::SubmitInfo::default()
+                    .wait_semaphores(&semaphores)
+                    .wait_dst_stage_mask(&stages)
+                    .push_next(&mut timeline);
+                device.queue_submit(hal_queue.as_raw(), &[submit], vk::Fence::null())
+            };
+            if let Err(error) = result {
+                log::error!("wgpuQueue*SharedFence (Vulkan): {error:?}");
+                return false;
+            }
+            true
+        }
+    }
+}
+
+#[cfg(windows)]
+#[no_mangle]
+pub unsafe extern "C" fn wgpuQueueSignalSharedFence(
+    queue: native::WGPUQueue,
+    fence: *mut std::ffi::c_void,
+    value: u64,
+) -> native::WGPUBool {
+    shared_fence_on_queue(queue, fence, value, true) as native::WGPUBool
+}
+
+#[cfg(windows)]
+#[no_mangle]
+pub unsafe extern "C" fn wgpuQueueWaitSharedFence(
+    queue: native::WGPUQueue,
+    fence: *mut std::ffi::c_void,
+    value: u64,
+) -> native::WGPUBool {
+    shared_fence_on_queue(queue, fence, value, false) as native::WGPUBool
+}
+
+// openRTS's fork (D3D12): a fence shared by an NT handle (a D3D11 one made
+// with D3D11_FENCE_FLAG_SHARED) opened by the device; the ID3D12Fence* the
+// caller releases (IUnknown::Release), NULL when it cannot.
+#[cfg(all(windows, feature = "dx12"))]
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceOpenD3D12SharedFence(
+    device: native::WGPUDevice,
+    shared_handle: *mut std::ffi::c_void,
+) -> *mut std::ffi::c_void {
+    let (device_id, context) = {
+        let device = device.as_ref().expect("invalid device");
+        (device.id, &device.context)
+    };
+    let Some(hal_device) = context.device_as_hal::<hal::api::Dx12>(device_id) else {
+        log::error!("wgpuDeviceOpenD3D12SharedFence: the device is not D3D12's");
+        return std::ptr::null_mut();
+    };
+    let mut fence: Option<windows::Win32::Graphics::Direct3D12::ID3D12Fence> = None;
+    if let Err(error) = hal_device
+        .raw_device()
+        .OpenSharedHandle(windows::Win32::Foundation::HANDLE(shared_handle), &mut fence)
+    {
+        log::error!("wgpuDeviceOpenD3D12SharedFence: {error:?}");
+        return std::ptr::null_mut();
+    }
+    match fence {
+        Some(fence) => windows::core::Interface::into_raw(fence),
+        None => std::ptr::null_mut(),
+    }
+}
+
+// openRTS's fork (D3D12): `fence` (an ID3D12Fence*) set to `value` on the
+// queue's timeline after what was submitted so far (Signal), or the queue's
+// next work held until it reaches it (Wait). false: not a D3D12 queue.
+#[cfg(all(windows, feature = "dx12"))]
+unsafe fn queue_fence(
+    queue: native::WGPUQueue,
+    fence: *mut std::ffi::c_void,
+    value: u64,
+    signal: bool,
+) -> bool {
+    let (queue_id, context) = {
+        let queue = queue.as_ref().expect("invalid queue");
+        (queue.queue.id, &queue.queue.context)
+    };
+    let Some(fence) =
+        windows::core::Interface::from_raw_borrowed(&fence) as Option<&windows::Win32::Graphics::Direct3D12::ID3D12Fence>
+    else {
+        return false;
+    };
+    let Some(hal_queue) = context.queue_as_hal::<hal::api::Dx12>(queue_id) else {
+        log::error!("wgpuQueue*D3D12Fence: the queue is not D3D12's");
+        return false;
+    };
+    let result = if signal {
+        hal_queue.as_raw().Signal(fence, value)
+    } else {
+        hal_queue.as_raw().Wait(fence, value)
+    };
+    if let Err(error) = result {
+        log::error!("wgpuQueue*D3D12Fence: {error:?}");
+        return false;
+    }
+    true
+}
+
+#[cfg(all(windows, feature = "dx12"))]
+#[no_mangle]
+pub unsafe extern "C" fn wgpuQueueSignalD3D12Fence(
+    queue: native::WGPUQueue,
+    fence: *mut std::ffi::c_void,
+    value: u64,
+) -> native::WGPUBool {
+    queue_fence(queue, fence, value, true) as native::WGPUBool
+}
+
+#[cfg(all(windows, feature = "dx12"))]
+#[no_mangle]
+pub unsafe extern "C" fn wgpuQueueWaitD3D12Fence(
+    queue: native::WGPUQueue,
+    fence: *mut std::ffi::c_void,
+    value: u64,
+) -> native::WGPUBool {
+    queue_fence(queue, fence, value, false) as native::WGPUBool
+}
+
+// openRTS's fork: a texture over a D3D11 texture shared by an NT handle, for
+// a frame handed to OpenXR's D3D11 swapchain or NVIDIA DLSS on D3D11 without
+// the CPU. Vulkan: wgpu-hal's `texture_from_d3d11_shared_handle` (the device
+// asked for VULKAN_EXTERNAL_MEMORY_WIN32); D3D12: the handle opened by the
+// device (`OpenSharedHandle`), the resource taken by `texture_from_raw`.
+#[cfg(all(windows, any(feature = "vulkan", feature = "dx12")))]
+#[no_mangle]
+pub unsafe extern "C" fn wgpuDeviceImportD3D11SharedTexture(
+    device: native::WGPUDevice,
+    shared_handle: *mut std::ffi::c_void,
+    descriptor: Option<&native::WGPUTextureDescriptor>,
+) -> native::WGPUTexture {
+    let (device_id, context, error_sink) = {
+        let device = device.as_ref().expect("invalid device");
+        (device.id, &device.context, &device.error_sink)
+    };
+    let descriptor = descriptor.expect("invalid descriptor");
+    let desc = wgt::TextureDescriptor {
+        label: string_view_into_label(descriptor.label),
+        size: conv::map_extent3d(&descriptor.size),
+        mip_level_count: descriptor.mipLevelCount,
+        sample_count: descriptor.sampleCount,
+        dimension: conv::map_texture_dimension(descriptor.dimension)
+            .unwrap_or(wgt::TextureDimension::D2),
+        format: conv::map_texture_format(descriptor.format)
+            .expect("invalid texture format for texture descriptor"),
+        usage: from_u64_bits(descriptor.usage)
+            .expect("invalid texture usage for texture descriptor"),
+        view_formats: Vec::new(),
+    };
+    let hal_desc = hal::TextureDescriptor {
+        label: None,
+        size: desc.size,
+        mip_level_count: desc.mip_level_count,
+        sample_count: desc.sample_count,
+        dimension: desc.dimension,
+        format: desc.format,
+        usage: wgt::TextureUses::COLOR_TARGET
+            | wgt::TextureUses::COPY_SRC
+            | wgt::TextureUses::COPY_DST
+            | wgt::TextureUses::RESOURCE,
+        memory_flags: hal::MemoryFlags::empty(),
+        view_formats: Vec::new(),
+    };
+    let mut made: Option<(wgc::id::TextureId, Option<wgc::resource::CreateTextureError>)> = None;
+    #[cfg(feature = "vulkan")]
+    if made.is_none() {
+        if let Some(hal_device) = context.device_as_hal::<hal::api::Vulkan>(device_id) {
+            let texture = match hal_device.texture_from_d3d11_shared_handle(
+                windows::Win32::Foundation::HANDLE(shared_handle),
+                &hal_desc,
+            ) {
+                Ok(texture) => texture,
+                Err(error) => {
+                    log::error!("wgpuDeviceImportD3D11SharedTexture (Vulkan): {error:?}");
+                    return std::ptr::null_mut();
+                }
+            };
+            drop(hal_device);
+            made = Some(context.create_texture_from_hal(Box::new(texture), device_id, &desc, None));
+        }
+    }
+    #[cfg(feature = "dx12")]
+    if made.is_none() {
+        if let Some(hal_device) = context.device_as_hal::<hal::api::Dx12>(device_id) {
+            let mut resource: Option<windows::Win32::Graphics::Direct3D12::ID3D12Resource> = None;
+            if let Err(error) = hal_device
+                .raw_device()
+                .OpenSharedHandle(windows::Win32::Foundation::HANDLE(shared_handle), &mut resource)
+            {
+                log::error!("wgpuDeviceImportD3D11SharedTexture (D3D12): {error:?}");
+                return std::ptr::null_mut();
+            }
+            let Some(resource) = resource else {
+                log::error!("wgpuDeviceImportD3D11SharedTexture (D3D12): no resource");
+                return std::ptr::null_mut();
+            };
+            drop(hal_device);
+            let texture = hal::dx12::Device::texture_from_raw(
+                resource,
+                desc.format,
+                desc.dimension,
+                desc.size,
+                desc.mip_level_count,
+                desc.sample_count,
+            );
+            made = Some(context.create_texture_from_hal(Box::new(texture), device_id, &desc, None));
+        }
+    }
+    let Some((texture_id, error)) = made else {
+        log::error!("wgpuDeviceImportD3D11SharedTexture: the device is neither Vulkan's nor D3D12's");
+        return std::ptr::null_mut();
