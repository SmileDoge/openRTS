	Cargo (
		ID ( ASH )
		Name ( "Ash" )
		RussianName ( "Зола" )
		Density ( 1000 )
		Pile ( 0.3 )
		LoadingType ( PILE )
		Texture ( oRTSCargo_ash )
	)
